# Example nginx config for piano.harmony4all.org
#
# The app + real-time relay are one Node server on 8550 (relay-server.js).
# The relay WebSocket lives at /relay on the same origin, so the whole site is
# proxied to 8550 with WebSocket upgrade support. Media uploads go to 8551.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name piano.harmony4all.org;

    # Required for Room DJ uploads (up to 80 MB)
    client_max_body_size 80m;

    # App, static files, and the /relay WebSocket — all on 8550.
    location / {
        proxy_pass http://127.0.0.1:8550;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;   # enables /relay WebSocket
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;                          # keep relay sockets alive
    }

    # Room DJ media upload/serve on the media server (8551).
    location /api/media {
        proxy_pass http://127.0.0.1:8551;
        client_max_body_size 80m;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /room-media/ {
        proxy_pass http://127.0.0.1:8551;
    }
}
